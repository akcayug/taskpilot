# Database Configuration (for Docker Compose)
DB_NAME=taskpilot
DB_USER=taskpilot
DB_PASSWORD=changeme_in_production

# Database URL (used by Django)
DATABASE_URL=postgresql://taskpilot:changeme_in_production@db:5432/taskpilot

# Celery/Redis Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production-use-50-chars-random
DEBUG=False
ALLOWED_HOSTS=*

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHI-jklMNOpqrsTUVwxyz

# Web Service URL (for bot to call API)
WEB_SERVICE_URL=http://web:8000

# Email Configuration (Optional - for invitation emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@taskpilot.com
