FROM python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    netcat-traditional \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (bot needs access to Django models)
COPY . .

# Expose healthz port
EXPOSE 8001

# Run bot with healthz server
CMD python -c "import os; os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'taskpilot.settings'); import django; django.setup(); from bot.healthz import run_healthz_background; from bot.main import main; run_healthz_background(); main()"
